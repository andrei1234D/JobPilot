{
  "name": "@jobpilot/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Manifest V3 extension: 'seen before?', red flags and quick-add on job postings, backed by the local JobPilot server.",
  "scripts": {
