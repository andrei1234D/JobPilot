    "@types/react-dom": "^19.0.2",
    "esbuild": "^0.24.2",
    "jsdom": "^25.0.1",
    "@types/jsdom": "^21.1.7",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
