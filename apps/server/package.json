{
  "name": "@jobpilot/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local, read-only API over the Markdown job-hunt logs. Binds to 127.0.0.1 only.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.0.4",
    "@jobpilot/shared": "workspace:*",
    "chokidar": "^4.0.3",
    "fastify": "^5.2.1",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
